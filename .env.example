# Base de données
DATABASE_URL=sqlite:///./offertrail.db

# Supabase Auth — OBLIGATOIRE en prod
# JWT Secret : Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=      # Settings → API → service_role key

# Stripe (optionnel en local)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs Stripe — Products → OfferTrail Pro/Ultimate → copier l'ID du prix
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ULTIMATE_MONTHLY=price_...
STRIPE_PRICE_ULTIMATE_YEARLY=price_...
STRIPE_LAUNCH_TRIAL_DAYS=30
# Tester les webhooks : stripe listen --forward-to localhost:8000/subscription/webhook

# Email Resend (optionnel en local)
RESEND_API_KEY=

# CORS - séparer par virgule
ALLOWED_ORIGINS=http://localhost:5173

# URL de l'app (pour les redirects Stripe)
APP_BASE_URL=http://localhost:5173
