{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build": "npm run typecheck && vite build && npm run budget",
    "budget": "node scripts/check-bundle-budget.mjs",
    "check": "npm run format:check && npm run lint && npm run stylelint && npm run typecheck && npm run deadcode",
    "deadcode": "knip --no-progress --no-config-hints",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run && npm run test:legacy",
    "test:coverage": "vitest run --coverage && npm run test:legacy",
    "test:e2e": "playwright test",
    "test:legacy": "node --test tests/*.test.mjs",
    "stylelint": "stylelint \"src/**/*.{css,scss}\" --max-warnings=0",
    "stylelint:fix": "npm run stylelint -- --fix",
    "typecheck": "tsc --build --pretty false"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "knip": "^6.32.2",
    "msw": "^2.12.10",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "description": "OfferTrail frontend",
  "main": "eslint.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
