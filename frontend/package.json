{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build": "npm run typecheck && vite build",
    "check": "npm run format:check && npm run lint && npm run stylelint && npm run typecheck && npm run deadcode",
    "deadcode": "knip --no-progress --no-config-hints",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "stylelint": "stylelint \"src/**/*.{css,scss}\" --max-warnings=0",
    "stylelint:fix": "npm run stylelint -- --fix",
    "typecheck": "tsc --build --pretty false"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.13.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "7.3.1"
  },
  "description": "OfferTrail frontend",
  "main": "eslint.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
